# Nix
result
result-*
.direnv/

# Secrets
*.key
*.pem
secrets/keys/*
!secrets/keys/.gitkeep

# Backups
*.backup
*.bak
*.old

# Temporary
*.tmp
*.swp
.DS_Store
.cache/
.lint-reports/
.script-inventory/
workspace/system/diagnostics/network/network/reports/
workspace/system/diagnostics/network-utils/network/reports/

# Obsidian
.obsidian/
.trash/

# Node
node_modules/
domains/business/estimator/app/.env*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Archive
.archive/
.aider*

# Claude Code - Machine-specific and generated configs
# .mcp.json is a store symlink written by hwc.system.apps.agent-harness.projectMcp.
.mcp.json
.claude/settings.local.json
.claude/.claude/settings.local.json
.claude/auto-push-cron.sh
.claude/auto-push.log

# n8n workflows - exported/generated files
domains/server/n8n/parts/workflows/*.json
n8n-simple.json
domains/business/datax/dashboard/dashboard.json

# morning-briefing - generated runtime artifacts
domains/business/morning-briefing/logs/*.log
# Everything the briefing and dispatch units write at runtime (briefing.json,
# dispatch cards, dispatch-done, reports, calendar-drafts). Only .gitkeep is
# tracked so the directory exists on a fresh clone.
domains/business/morning-briefing/output/*
!domains/business/morning-briefing/output/.gitkeep
domains/business/morning-briefing/dashboard/briefing.json
.backups/
.wrangler/
