# domains/home/apps/codex/index.nix
{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:
let
  cfg = config.hwc.home.apps.codex;
  codexPkg = if cfg.package != null then cfg.package else (pkgs.codex or null);
  home = config.home.homeDirectory;
  repo = cfg.sharedConfigRepo;

  # ~/.codex/AGENTS.md is DERIVED state: the files the harness manifest lists
  # under [budget].codex, whose word-budget check counts the same list. The
  # principles digest is no longer embedded: principles-primer.sh delivers it on
  # the first edit through the hook bridge (S4, 2026-11-12). Rendered per host,
  # so two hosts can never conflict on it. A hand-written file found in place is
  # kept once as AGENTS.md.pre-render.bak.
  codexRules = (builtins.fromTOML (builtins.readFile "${repo}/manifest.toml")).budget.codex;
  agentsRender = pkgs.writeShellApplication {
    name = "codex-agents-render";
    runtimeInputs = with pkgs; [
      coreutils
      gawk
      diffutils
    ];
    text = ''
      REPO=${lib.escapeShellArg repo}
      OUT="$HOME/.codex/AGENTS.md"
      MARK='<!-- GENERATED by codex-agents-render from the Nix-pinned agent harness -->'
      SOURCES=(${lib.escapeShellArgs codexRules})
      for src in "''${SOURCES[@]}"; do
        [ -r "$REPO/$src" ] || { echo "codex-agents-render: missing $REPO/$src" >&2; exit 1; }
      done
      mkdir -p "$HOME/.codex"
      TMP=$(mktemp "$OUT.XXXXXX")
      {
        printf '%s\n\n' "$MARK"
        for src in "''${SOURCES[@]}"; do cat "$REPO/$src"; printf '\n'; done
      } > "$TMP"
      if [ -e "$OUT" ] && ! head -n 1 "$OUT" | cmp -s - <(printf '%s\n' "$MARK") \
         && [ ! -e "$OUT.pre-render.bak" ]; then
        cp -p "$OUT" "$OUT.pre-render.bak"
        echo "codex-agents-render: kept hand-written $OUT as $OUT.pre-render.bak"
      fi
      if cmp -s "$TMP" "$OUT"; then rm -f "$TMP"; else mv "$TMP" "$OUT"; echo "codex-agents-render: wrote $OUT"; fi
    '';
  };

  # Codex runs a hook only after its hash is trusted in the host's config.toml.
  # The binary list mirrors the order T3's server PATH finds codex in; the hash
  # does not depend on the Codex version (measured 2026-09-17: a hook trusted by
  # the laptop's 0.146 matched the hash 0.154 computes).
  hooksTrust = pkgs.writeShellApplication {
    name = "codex-hooks-trust";
    # nodejs: the npm codex is a `#!/usr/bin/env node` launcher, and activation
    # PATH carries no node (measured on hwc-server: it fell through to 0.92).
    runtimeInputs = [
      pkgs.python3
      pkgs.nodejs
    ];
    text = ''
      exec python3 ${./hooks-trust.py} "$@" "$HOME/.npm-global/bin/codex" ${codexPkg}/bin/codex
    '';
  };

  # Codex gets the MCP servers in agent-harness's generated ~/.mcp.json, the one
  # list Claude Code reads. config.toml holds per-host hook trust, so it is not a
  # store link; `codex mcp add/remove` edit only their own table (measured: an
  # add and remove leave the rest of the file byte-identical).
  mcpSync = pkgs.writeShellApplication {
    name = "codex-mcp-sync";
    runtimeInputs = [
      pkgs.python3
      pkgs.nodejs
    ];
    text = ''
      args=()
      [ "''${1:-}" = --check ] && args=(--check)
      exec python3 ${./mcp-sync.py} "''${args[@]}" "$HOME/.mcp.json" ${codexPkg}/bin/codex
    '';
  };
in
{
  #==========================================================================
  # OPTIONS
  #==========================================================================
  options.hwc.home.apps.codex = {
    enable = lib.mkEnableOption "OpenAI Codex CLI";

    package = lib.mkOption {
      type = lib.types.nullOr lib.types.package;
      default = null;
      description = "Codex package to use. If null, use pkgs.codex from the selected channel.";
    };

    env = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      description = "Additional environment variables for Codex CLI";
    };

    sharedConfigRepo = lib.mkOption {
      type = lib.types.str;
      default = toString inputs.agent-harness;
      description = "Nix-pinned agent harness source for Codex hooks and AGENTS.md inputs.";
    };

    # Skills are not set here. Codex reads ~/.agents/skills, which the
    # agent-harness module links to the one skill set every runtime loads. The
    # per-skill allowlists that used to live here were the cause of the drift.

    # Hooks and instructions follow the harness share: a host that does
    # not carry the repo gets neither, instead of dangling links.
    shareHarness = lib.mkOption {
      type = lib.types.bool;
      default = config.hwc.home.apps.agent-harness.enable;
      description = "Link ~/.codex/hooks.json from sharedConfigRepo, render ~/.codex/AGENTS.md, and trust the shared hooks on activation and after each harness publish.";
    };
  };

  #==========================================================================
  # IMPLEMENTATION
  #==========================================================================
  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      {
        home.packages = [ codexPkg ];

        home.sessionVariables = cfg.env;

        # Create config directory
        xdg.configFile."codex/.keep".text = "";
      }

      (lib.mkIf cfg.shareHarness {
        home.packages = [
          agentsRender
          hooksTrust
          mcpSync
        ];

        # One hooks.json for every host. herdr's own entry is in it, so
        # `herdr integration install codex` must not be run against the link.
        home.file.".codex/hooks.json".source =
          config.lib.file.mkOutOfStoreSymlink "${repo}/adapters/codex/hooks.json";

        home.activation.codexSharedHarness = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
          run ${agentsRender}/bin/codex-agents-render \
            || echo "codex: AGENTS.md render failed" >&2
          run ${hooksTrust}/bin/codex-hooks-trust \
            || echo "codex: shared hooks are not all trusted — run codex-hooks-trust" >&2
          if [ -e "$HOME/.codex_p/hooks.json" ]; then
            run env CODEX_HOME="$HOME/.codex_p" ${hooksTrust}/bin/codex-hooks-trust \
              || echo "codex: T3 profile hooks are not all trusted — run CODEX_HOME=$HOME/.codex_p codex-hooks-trust" >&2
          fi
          # ~/.codex_p links config.toml to ~/.codex, so one run covers T3 too.
          run ${mcpSync}/bin/codex-mcp-sync \
            || echo "codex: MCP servers not mirrored from ~/.mcp.json — run codex-mcp-sync" >&2
        '';

      })

      #========================================================================
      # VALIDATION
      #========================================================================
      {
        assertions = [
          {
            assertion = codexPkg != null;
            message = "codex package must be available";
          }
        ];
      }
    ]
  );
}
