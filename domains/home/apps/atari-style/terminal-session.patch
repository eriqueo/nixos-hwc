+"""Drive real game loops with a single recognized keyboard event per frame."""
+import importlib
+from blessed.keyboard import Keystroke
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+MODULES = [(f'atari_style.demos.games.{name}', cls) for name, cls in [('breakout', 'Breakout'), ('galaga', 'Galaga'), ('grandprix', 'GrandPrix')]] + [(f'terminal_arcade.games.{name}.game', cls) for name, cls in [('breakout', 'Breakout'), ('galaga', 'Galaga'), ('grandprix', 'GrandPrix')]]
+
+
+class FrameFinished(Exception):
+    pass
+
+
+class GameControls(unittest.TestCase):
+    def frame(self, path, cls, event):
+        module = importlib.import_module(path)
+        handler = MagicMock()
+        handler.get_input.return_value = getattr(module.InputType, event)
+        handler.get_joystick_state.return_value = (0, 0)
+        handler.get_joystick_buttons.return_value = {}
+        handler.term.inkey.return_value = Keystroke('')
+        renderer = SimpleNamespace(width=120, height=40, enter_fullscreen=lambda: None, exit_fullscreen=lambda: None)
+        with patch.object(module, 'Renderer', return_value=renderer), patch.object(module, 'InputHandler', return_value=handler):
+            game = getattr(module, cls)()
+        if cls == 'Galaga':
+            game.state = game.STATE_PLAYING
+        elif cls == 'GrandPrix':
+            game.state = game.STATE_RACING
+        initial = game.paddle_x if cls == 'Breakout' else game.player.x if cls == 'Galaga' else game.lateral
+        game.last_time -= 0.02
+        def finish_frame():
+            raise FrameFinished
+        game.draw = finish_frame
+        try:
+            game.run()
+        except FrameFinished:
+            pass
+        position = game.paddle_x if cls == 'Breakout' else game.player.x if cls == 'Galaga' else game.lateral
+        return game, initial, position, handler
+
+    def test_movement(self):
+        for path, cls in MODULES:
+            for event, direction in [('LEFT', -1), ('RIGHT', 1)]:
+                with self.subTest(module=path, event=event):
+                    game, initial, position, handler = self.frame(path, cls, event)
+                    self.assertGreater((position - initial) * direction, 0, 'Movement key was swallowed by the game loop')
+                    handler.get_input.assert_called_once()
+                    handler.term.inkey.assert_not_called()
+
+    def test_action(self):
+        for path, cls in MODULES:
+            with self.subTest(module=path):
+                game, _, _, handler = self.frame(path, cls, 'UP' if cls == 'GrandPrix' else 'SELECT')
+                if cls == 'Breakout':
+                    self.assertEqual(game.state, game.STATE_PLAYING, 'Space/Enter did not launch the ball')
+                    self.assertFalse(game.balls[0].on_paddle)
+                elif cls == 'Galaga':
+                    self.assertGreater(game.shots_fired, 0, 'Space/Enter did not fire')
+                else:
+                    self.assertGreater(game.speed, 0, 'Up/W did not accelerate')
+                handler.get_input.assert_called_once()
+                handler.term.inkey.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
