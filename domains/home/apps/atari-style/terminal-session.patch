@@ -0,0 +1,76 @@
+"""Input devices must satisfy the X/Y contract; Breakout waits for launch."""
+import importlib
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+HANDLERS = ['atari_style.core.input_handler', 'terminal_arcade.engine.input_handler']
+GAMES = ['atari_style.demos.games.breakout', 'terminal_arcade.games.breakout.game']
+
+
+def device(axes):
+    result = MagicMock()
+    result.get_numaxes.return_value = axes
+    result.get_numbuttons.return_value = 2
+    result.get_button.return_value = 0
+    result.get_axis.return_value = -1.0
+    return result
+
+
+class InputDevices(unittest.TestCase):
+    def test_system_keyboard_is_not_a_game_controller(self):
+        for path in HANDLERS:
+            with self.subTest(module=path):
+                module = importlib.import_module(path)
+                fake = MagicMock()
+                keyboard = device(1)
+                fake.joystick.get_count.return_value = 1
+                fake.joystick.Joystick.return_value = keyboard
+                with patch.object(module, 'pygame', fake):
+                    handler = module.InputHandler()
+                    try:
+                        self.assertFalse(handler.joystick_initialized)
+                        self.assertEqual(handler.get_joystick_state(), (0.0, 0.0))
+                    finally:
+                        handler.cleanup()
+
+    def test_compatible_controller_after_system_keyboard_is_selected(self):
+        for path in HANDLERS:
+            with self.subTest(module=path):
+                module = importlib.import_module(path)
+                fake = MagicMock()
+                keyboard, controller = device(1), device(2)
+                fake.joystick.get_count.return_value = 2
+                fake.joystick.Joystick.side_effect = [keyboard, controller]
+                with patch.object(module, 'pygame', fake):
+                    handler = module.InputHandler()
+                    try:
+                        self.assertIs(handler.joystick, controller)
+                        self.assertTrue(handler.joystick_initialized)
+                        keyboard.quit.assert_called_once()
+                    finally:
+                        handler.cleanup()
+
+    def test_breakout_does_not_start_during_idle(self):
+        for path in GAMES:
+            with self.subTest(module=path):
+                module = importlib.import_module(path)
+                handler = MagicMock()
+                handler.get_joystick_state.return_value = (0.0, 0.0)
+                handler.get_joystick_buttons.return_value = {}
+                with patch.object(module, 'Renderer', return_value=SimpleNamespace(width=120, height=40)), patch.object(module, 'InputHandler', return_value=handler):
+                    game = module.Breakout()
+                initial = game.paddle_x
+                for _ in range(50):
+                    game.update_paddle(0.1, module.InputType.NONE)
+                    game.update(0.1)
+                self.assertEqual(game.state, game.STATE_SERVING)
+                self.assertEqual(game.paddle_x, initial)
+                self.assertTrue(game.balls[0].on_paddle)
+                game.update_paddle(0.1, module.InputType.SELECT)
