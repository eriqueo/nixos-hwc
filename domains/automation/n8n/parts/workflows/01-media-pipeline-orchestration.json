    {
      "id": "223866c2-fc1a-484e-b11a-e1bb47d308c9",
      "name": "Parse Event",
      "parameters": {
        "jsCode": "// Normalize incoming *arr webhook into a standard shape\nconst body = $input.item.json.body || $input.item.json || {};\nconst query = $input.item.json.query || {};\nlet source = (query.source || body.source || '').toString().toLowerCase();\nif (!source) {\n  if (body.movie || body.remoteMovie) source = 'radarr';\n  else if (body.series || body.episodes) source = 'sonarr';\n  else source = 'unknown';\n}\nlet title = '', path = '', quality = '', eventType = body.eventType || 'Download', searchTitle = '', itemType = '';\nif (source === 'radarr') {\n  title = body?.movie?.title || body?.remoteMovie?.title || '';\n  path = body?.movieFile?.path || body?.movie?.path || '';\n  quality = body?.movieFile?.quality?.quality?.name || '';\n  searchTitle = title; itemType = 'Movie';\n} else if (source === 'sonarr') {\n  const seriesTitle = body?.series?.title || '';\n  const ep = (body?.episodes && body.episodes[0]) || {};\n  const epNum = ep.seasonNumber != null ? `S${String(ep.seasonNumber).padStart(2,'0')}E${String(ep.episodeNumber).padStart(2,'0')}` : '';\n  title = `${seriesTitle} ${epNum}`.trim();\n  path = body?.episodeFile?.path || ''; quality = body?.episodeFile?.quality?.quality?.name || '';\n  searchTitle = seriesTitle; itemType = 'Series';\n} else {\n  title = body?.title || 'Unknown'; path = body?.path || ''; quality = body?.quality || '';\n  searchTitle = title; itemType = 'Movie';\n}\nreturn { json: { mediaType: source, title, searchTitle, itemType, path, quality, eventType } };"
      },
