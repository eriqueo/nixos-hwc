      "parameters": {
        "jsCode": "// Parse and filter Frigate events with smart priority + cooldown dedup\nconst body = $input.item.json.body || $input.item.json;\n\n// CRITICAL: Only process 'end' events for one notification per detection\nconst eventType = body.type;\nif (eventType !== 'end') {\n  return [];\n}\n\nconst event = body.after || body;\n// Use the configured workflow zone explicitly: the Code runner uses UTC.\nconst date = $now.setZone($env.GENERIC_TIMEZONE);\nconst hour = date.hour;\nconst nowMs = date.toMillis();\nconst formattedTime = date.toFormat('h:mm a');\nconst formattedDate = date.toFormat('MMM d');\n\nconst isDaytime = hour >= 7 && hour < 22;\nconst isNight = !isDaytime;\n\nconst eventId = event.id;\nconst camera = event.camera;\nconst object = event.label;\nconst score = event.top_score || 0;\n\n// Names match the actual frigate config (domains/media/frigate/parts/config.nix).\n// The old map (Front Door/Driveway/Backyard/Carport + a nonexistent\n// cobra_cam_4) mislabeled every notification.\nconst cameraNames = {\n  'cobra_cam_1': 'Carport',\n  'cobra_cam_2': 'Side Yard',\n  'cobra_cam_3': 'Front Porch',\n  'reolink': 'Front Yard'\n};\nconst cameraName = cameraNames[camera] || camera;\n\n// Link readiness is checked downstream; retention does not guarantee a clip.\nconst clipUrl = `https://frigate.hwc.iheartwoodcraft.com/api/events/${eventId}/clip.mp4`;\n// HLS variant for iOS: the mp4 endpoint streams ffmpeg output chunked with no\n// byte-range support, which iPhone AVPlayer refuses; the nginx vod module\n// serves the same event as HLS with range support, which iOS plays natively.\nconst hlsUrl = `https://frigate.hwc.iheartwoodcraft.com/vod/event/${eventId}/master.m3u8`;\nconst eventUrl = `https://frigate.hwc.iheartwoodcraft.com/explore?event_id=${eventId}`;\n\n// --- Hard filters ---\nif (score < 0.6) return [];\nif (['plant', 'tree'].includes(object)) return [];\n\n// Require a configured zone before notifying.\nconst zones = event.entered_zones || [];\nif (zones.length === 0) return [];\nconst zone = zones.join(', ');\n\n// Drop daytime cars entirely \u2014 never interesting\nif (object === 'car' && isDaytime) return [];\n\n// Higher confidence threshold for non-person objects\nif (object !== 'person' && score < 0.85) return [];\n\n// --- Cooldown dedup (per camera+object) ---\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.cooldowns) staticData.cooldowns = {};\n\n// Purge stale entries older than 1 hour\nfor (const key of Object.keys(staticData.cooldowns)) {\n  if (nowMs - staticData.cooldowns[key] > 3600000) {\n    delete staticData.cooldowns[key];\n  }\n}\n\nconst cooldownKey = `${camera}:${object}`;\nconst cooldownMs = object === 'person' ? 120000 : 300000; // 2min person, 5min other\n\nif (staticData.cooldowns[cooldownKey] && (nowMs - staticData.cooldowns[cooldownKey]) < cooldownMs) {\n  return []; // Still in cooldown \u2014 suppress\n}\nstaticData.cooldowns[cooldownKey] = nowMs;\n\n// --- Priority assignment ---\nlet priority = 2;\nlet isPerson = false;\n\nif (object === 'person') {\n  isPerson = true;\n  priority = isNight ? 5 : 4;\n} else if (['car', 'truck'].includes(object) && isNight && camera === 'reolink') {\n  // Night vehicle on the front yard. reolink is the ONLY camera that\n  // tracks car/truck \u2014 the old cobra_cam_3 condition could never fire.\n  isPerson = true;\n  priority = 5;\n} else {\n  priority = 2;\n}\n\nreturn [\n  {\n    json: {\n      eventId,\n      camera,\n      cameraName,\n      zone,\n      object,\n      score,\n      priority,\n      isPerson,\n      isNight,\n      clipUrl,\n      hlsUrl,\n      eventUrl,\n      formattedTime,\n      formattedDate,\n      timestamp: date.toISO()\n    }\n  }\n];\n"
