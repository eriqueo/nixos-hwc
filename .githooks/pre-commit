#!/usr/bin/env bash
# Validate exactly the staged snapshot, including rules and fixtures from that tree.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
snapshot=$(mktemp -d -t hwc-index.XXXXXX)
trap 'rm -rf -- "$snapshot"' EXIT
git archive "$(git write-tree)" | tar -x -C "$snapshot"
python3 "$snapshot/workspace/nixos-dev/verification/release.py" governance --repo "$snapshot"
